description "Select custom library after native services are ready"
start on started kppmainapp or started kindle-library-native
task
script
    i=0
    while [ "$i" -lt 60 ]; do
        if lipc-get-prop org.kindlepowerful.library logLevel >/dev/null 2>&1; then
            register /mnt/us/library-default.install || exit 1
            lipc-set-prop com.lab126.appmgrd startdefault 0
            exit 0
        fi
        sleep 1
        i=$((i + 1))
    done
    # Keep the original default if custom home has failed to start.
    register /app/registry/kpp_home_default_app.install
    exit 1
end script
